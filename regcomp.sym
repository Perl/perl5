            {
              "NAME" => "EXACTFLU8",
              "TYPE" => "EXACT",
              "attr" => {
                  "arg_spec" => "str",
                  "str_arg" => 1,
                },
              "comment" =>
                "In order for a non-UTF-8 EXACTFAA to think the " .
                "pattern is pre-folded when matching a UTF-8 target " .
                "string, there would have to be something like an " .
                "EXACTFAA_MICRO which would not be considered " .
                "pre-folded for UTF-8 targets, since the fold of " .
                "the MICRO SIGN would not be done, and would be " .
                "representable in the UTF-8 target string.",
              "desc" =>
                "Like EXACTFU, but use /il, UTF-8, (string is folded, " .
                "and everything in it is above 255",
              "line" => __LINE__,
            },
            {
              "NAME" => "EXACT_REQ8",
              "TYPE" => "EXACT",
              "attr" => {
                  "arg_spec" => "str",
                  "str_arg" => 1,
                },
              "desc" => "Like EXACT, but only UTF-8 encoded targets can match",
              "line" => __LINE__,
            },
            {
              "NAME" => "LEXACT_REQ8",
              "TYPE" => "EXACT",
              "attr" => {
                  "arg_spec" => "len:str",
                  "str_arg" => 1,
                },
              "desc" => "Like LEXACT, but only UTF-8 encoded targets can match",
              "line" => __LINE__,
              "struct" => "regnode_1",
            },
            {
              "NAME" => "EXACTFU_REQ8",
              "TYPE" => "EXACT",
              "attr" => {
                  "arg_spec" => "str",
                  "str_arg" => 1,
                },
              "desc" => "Like EXACTFU, but only UTF-8 encoded targets can match",
              "line" => __LINE__,
            },
            {
              "NAME" => "EXACTFU_S_EDGE",
              "TYPE" => "EXACT",
              "attr" => {
                  "arg_spec" => "str",
                  "str_arg" => 1,
                },
              "comment" =>
                "One could add EXACTFAA8 and something that has the " .
                "same effect for /l, but these would be extremely " .
                "uncommon",
              "desc" =>
                "/di rules, but nothing in it precludes /ui, except " .
                "begins and/or ends with [Ss]; (string not UTF-8; " .
                "compile-time only)",
              "line" => __LINE__,
            },
          ],
